PORT=4000
# Use Session pooler URI from Supabase Dashboard → Database (not the direct IPv6 host)
# This is the privileged DB URL (postgres / service-equivalent). NEVER put it in the frontend.
# NEVER put Supabase anon key or service_role JWT in the Next.js / browser env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:3000
# Optional extras (comma-separated), e.g. https://your-store.vercel.app
# CLIENT_URLS=
# DANGEROUS in production: allows ANY *.vercel.app preview to use credentialed cookies
# CORS_VERCEL_PREVIEWS=true
NODE_ENV=development
# Default admin created by npm run db:seed (only one admin is kept)
# Always set a strong ADMIN_PASSWORD in production — seed refuses Admin123! when NODE_ENV=production
# ADMIN_EMAIL=admin@clover.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Clover Admin
# Default reception (floor) account — seed refuses Reception123! when NODE_ENV=production
# RECEPTION_EMAIL=reception@clover.com
# RECEPTION_PASSWORD=
# RECEPTION_NAME=Clover Reception
